# ---- ฐานข้อมูล (Neon / Vercel Postgres / AWS RDS ก็ได้ ใช้ connection string เดียวกัน) ----
# หาได้จากหน้า Neon Dashboard > Connection string (เลือกแบบ "Pooled connection")
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- ความลับของระบบ (บังคับตั้ง ห้ามปล่อยว่างบน production) ----
# สุ่มด้วย: openssl rand -base64 48
SESSION_SECRET=

# คีย์เข้ารหัสเลขบัตรประชาชน (base64, 32 bytes)
# สุ่มด้วย: openssl rand -base64 32
# *** ถ้าคีย์นี้หาย เลขบัตรที่เข้ารหัสไว้จะอ่านไม่ออกถาวร เก็บสำรองไว้ที่ปลอดภัย ***
ENCRYPTION_KEY=

# ---- ที่เก็บรูปภาพ ----
# Vercel Blob (ตั้งอัตโนมัติเมื่อเชื่อม Blob store ใน Vercel Dashboard)
# ถ้าไม่ตั้ง ตอนรัน dev เครื่องตัวเองจะเก็บลงโฟลเดอร์ uploads/ แทน
BLOB_READ_WRITE_TOKEN=

# ---- รหัสผ่านเริ่มต้นตอน seed (ตั้งให้ปลอดภัยก่อนรัน npm run seed) ----
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
