# ---- ฐานข้อมูล (Neon / Vercel Postgres / AWS RDS ก็ได้ ใช้ connection string เดียวกัน) ----
# หาได้จากหน้า Neon Dashboard > Connection string (เลือกแบบ "Pooled connection")
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- ความลับของระบบ (บังคับตั้ง ห้ามปล่อยว่างบน production) ----
# สุ่มด้วย: openssl rand -base64 48
SESSION_SECRET=

# คีย์เข้ารหัสเลขบัตรประชาชน (base64, 32 bytes)
# สุ่มด้วย: openssl rand -base64 32
# *** ถ้าคีย์นี้หาย เลขบัตรที่เข้ารหัสไว้จะอ่านไม่ออกถาวร เก็บสำรองไว้ที่ปลอดภัย ***
ENCRYPTION_KEY=

# ---- ที่เก็บรูปภาพ (Vercel Blob) ----
# มีสองแบบ ใช้แบบใดแบบหนึ่ง — ตั้งอัตโนมัติเมื่อเชื่อม Blob store ใน Vercel Dashboard
#
# แบบใหม่ (OIDC): Vercel จะฉีด BLOB_STORE_ID มาให้ ส่วน VERCEL_OIDC_TOKEN
#   ระบบสร้างให้เองตอน runtime **ไม่โผล่ในหน้า Environment Variables** — ปกติแล้ว
#   เห็นแค่ BLOB_STORE_ID ก็แปลว่าเชื่อมสำเร็จแล้ว ไม่ต้องหา token อีก
# แบบเดิม: BLOB_READ_WRITE_TOKEN
#
# ไม่มีทั้งคู่ = เก็บลงโฟลเดอร์ uploads/ ของเครื่องที่รัน (ใช้ได้เฉพาะตอน dev
# บน Vercel จะหายทุก cold start)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ---- รหัสผ่านเริ่มต้นตอน seed (ตั้งให้ปลอดภัยก่อนรัน npm run seed) ----
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# ---- พาสคีย์ (ไม่บังคับ) ----
# โดเมนที่พาสคีย์ผูกไว้ ปกติไม่ต้องตั้ง — ระบบอ่านจาก host ที่เบราว์เซอร์เรียกมาเอง
# ตั้งเป็นชื่อโดเมนล้วน ๆ (ห้ามมี https:// หรือ :port) เพื่อตรึงค่าไว้
# *** เปลี่ยนค่านี้หลังมีคนสร้างพาสคีย์แล้ว = พาสคีย์เดิมใช้ไม่ได้ทั้งหมด ***
WEBAUTHN_RP_ID=

# ---- Cloudflare Turnstile (ไม่บังคับ · กันบอทที่ฟอร์มสาธารณะ) ----
# ไม่ตั้งทั้งคู่ = ปิดการใช้งาน ฟอร์มทำงานเหมือนเดิมทุกอย่าง
# สมัครฟรีที่ https://dash.cloudflare.com > Turnstile > Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- งานลบข้อมูลตามกำหนด PDPA ----
# Vercel มักสร้างให้เองเมื่อมี cron ใน vercel.json · ถ้าไม่มี cron จะเรียก endpoint ไม่ผ่าน
# และไม่มีอะไรถูกลบเลยแบบเงียบ ๆ · สุ่มด้วย: openssl rand -base64 32
CRON_SECRET=
