# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามจริง
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# ตัวเลือก: กำหนดคีย์เข้ารหัสเอง (base64, 32 bytes) — ถ้าไม่กำหนด ระบบจะสร้างให้อัตโนมัติ
# และเก็บไว้ที่ data/.encryption_key (ห้าม commit ไฟล์นี้ขึ้น git)
# ENCRYPTION_KEY=

# รหัสผ่านเริ่มต้นตอน seed (เปลี่ยนได้ก่อนรัน npm run seed ครั้งแรก)
SEED_ADMIN_PASSWORD=admin1234
SEED_STAFF_PASSWORD=staff1234
